{
	"name": "rolldown-mdx-monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"type": "module",
	"scripts": {
		"build": "pnpm -C mdx build",
		"dev": "pnpm -C mdx dev",
		"test": "pnpm -C tests test",
		"typecheck": "pnpm -r typecheck",
		"release": "pnpm -C mdx build && bumpp mdx/package.json && pnpm publish --filter rolldown-mdx",
		"check": "biome ci .",
		"check.format": "biome format .",
		"check.lint": "biome check .",
		"fix": "pnpm lint && pnpm format",
		"format": "biome format --write .",
		"lint": "biome check --write --unsafe ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"bumpp": "^10.3.0"
	}
}
