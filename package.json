{
	"name": "rolldown-mdx-monorepo",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@10.11.0",
	"type": "module",
	"scripts": {
		"build": "pnpm -C mdx build",
		"dev": "pnpm -C mdx dev",
		"test": "vitest run --coverage && pnpm -C tests exec vitest run",
		"test.browser": "pnpm -C tests exec vitest run",
		"test.unit": "vitest run --coverage",
		"typecheck": "pnpm -r typecheck",
		"copy-readme": "cp README.md mdx/README.md",
		"release": "pnpm copy-readme && pnpm build && bumpp mdx/package.json && pnpm publish --filter rolldown-mdx",
		"check": "biome ci .",
		"check.format": "biome format .",
		"check.lint": "biome check .",
		"fix": "pnpm lint && pnpm format",
		"format": "biome format --write .",
		"lint": "biome check --write --unsafe ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@vitest/coverage-v8": "^4.0.14",
		"bumpp": "^10.3.0",
		"vitest": "^4.0.14"
	}
}
